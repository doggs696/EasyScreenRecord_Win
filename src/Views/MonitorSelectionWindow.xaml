<Window x:Class="EasyScreenRecord.Views.MonitorSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ディスプレイ選択" 
        Height="200" Width="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="録画するディスプレイを選択してください:" Margin="0,0,0,10"/>
        
        <ComboBox x:Name="MonitorComboBox" 
                  Grid.Row="1" 
                  DisplayMemberPath="DisplayText"
                  SelectedIndex="0"
                  SelectionChanged="MonitorComboBox_SelectionChanged"
                  Padding="5"/>
        
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="録画開始" Click="StartButton_Click" Padding="15,5" Margin="0,0,10,0"/>
            <Button Content="キャンセル" Click="CancelButton_Click" Padding="15,5"/>
        </StackPanel><!--/StackPanel-->
    </Grid><!--/Grid-->
</Window>
