<Window x:Class="EasyScreenRecord.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EasyScreenRecord.ViewModels"
        Title="Settings - EasyScreenRecord" Height="350" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    
    <Window.DataContext>
        <vm:SettingsViewModel />
    </Window.DataContext>

    <Border Padding="20">
        <StackPanel>
            <TextBlock Text="Smart Zoom Settings" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
            
            <!-- Zoom Factor -->
            <TextBlock Text="Zoom Factor (Magnification)" FontWeight="SemiBold"/>
            <DockPanel Margin="0,5,0,15">
                <TextBlock Text="{Binding ElementName=ZoomSlider, Path=Value, StringFormat=N1}" DockPanel.Dock="Right" Width="40" TextAlignment="Right"/>
                <Slider x:Name="ZoomSlider" Minimum="1.0" Maximum="3.0" TickFrequency="0.1" IsSnapToTickEnabled="True" 
                        Value="{Binding ZoomFactor}" AutoToolTipPlacement="TopLeft"/>
            </DockPanel>

            <!-- Zoom Speed -->
            <TextBlock Text="Smoothness (Speed)" FontWeight="SemiBold"/>
            <DockPanel Margin="0,5,0,15">
                <TextBlock Text="{Binding ElementName=SpeedSlider, Path=Value, StringFormat=N1}" DockPanel.Dock="Right" Width="40" TextAlignment="Right"/>
                <Slider x:Name="SpeedSlider" Minimum="1.0" Maximum="10.0" TickFrequency="0.5" IsSnapToTickEnabled="True" 
                        Value="{Binding ZoomSpeed}" AutoToolTipPlacement="TopLeft"/>
            </DockPanel>
            <TextBlock Text="Lower is smoother (slower), Higher is snappier." FontSize="11" Foreground="Gray" Margin="0,-10,0,15"/>

            <!-- Cursor Visibility -->
            <CheckBox Content="Show Mouse Cursor" IsChecked="{Binding ShowCursor}" Margin="0,0,0,15" />
            
            <Separator Margin="0,10" />

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Cancel" Command="{Binding CancelCommand}" Width="80" Margin="0,0,10,0" Padding="5"/>
                <Button Content="Save" Command="{Binding SaveCommand}" Width="80" Padding="5" IsDefault="True"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
