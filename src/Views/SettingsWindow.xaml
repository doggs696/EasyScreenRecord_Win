<Window x:Class="EasyScreenRecord.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EasyScreenRecord.ViewModels"
        Title="Settings - EasyScreenRecord" Height="420" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}">
    
    <Window.DataContext>
        <vm:SettingsViewModel />
    </Window.DataContext><!--/Window.DataContext-->

    <Border Padding="20">
        <StackPanel>
            <TextBlock Text="ズーム設定" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
            
            <!-- Zoom Mode Selection -->
            <TextBlock Text="ズームモード" FontWeight="SemiBold"/>
            <StackPanel Margin="0,5,0,10">
                <RadioButton Content="自動ズーム（タイピング検出）" IsChecked="{Binding IsAutoZoom}" Margin="0,0,0,5"/>
                <RadioButton Content="手動ズーム（Ctrl+スクロール）" IsChecked="{Binding IsManualZoom}"/>
            </StackPanel><!--/StackPanel-->
            <TextBlock Text="手動モード: Ctrl+スクロールでズーム、ミドルクリックで100%に戻る" FontSize="11" Foreground="Gray" Margin="0,0,0,15"/>
            
            <!-- Zoom Factor -->
            <TextBlock Text="最大ズーム倍率" FontWeight="SemiBold"/>
            <DockPanel Margin="0,5,0,15">
                <TextBlock Text="{Binding ElementName=ZoomSlider, Path=Value, StringFormat=N1}" DockPanel.Dock="Right" Width="40" TextAlignment="Right"/>
                <Slider x:Name="ZoomSlider" Minimum="1.0" Maximum="3.0" TickFrequency="0.1" IsSnapToTickEnabled="True" 
                        Value="{Binding ZoomFactor}" AutoToolTipPlacement="TopLeft"/>
            </DockPanel><!--/DockPanel-->

            <!-- Zoom Speed -->
            <TextBlock Text="スムーズネス（速度）" FontWeight="SemiBold"/>
            <DockPanel Margin="0,5,0,15">
                <TextBlock Text="{Binding ElementName=SpeedSlider, Path=Value, StringFormat=N1}" DockPanel.Dock="Right" Width="40" TextAlignment="Right"/>
                <Slider x:Name="SpeedSlider" Minimum="1.0" Maximum="10.0" TickFrequency="0.5" IsSnapToTickEnabled="True" 
                        Value="{Binding ZoomSpeed}" AutoToolTipPlacement="TopLeft"/>
            </DockPanel><!--/DockPanel-->
            <TextBlock Text="値が小さいほど滑らか、大きいほど機敏" FontSize="11" Foreground="Gray" Margin="0,-10,0,15"/>

            <!-- Cursor Visibility -->
            <CheckBox Content="マウスカーソルを表示" IsChecked="{Binding ShowCursor}" Margin="0,0,0,15" />
            
            <Separator Margin="0,10" />

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="キャンセル" Command="{Binding CancelCommand}" Width="80" Margin="0,0,10,0" Padding="5"/>
                <Button Content="保存" Command="{Binding SaveCommand}" Width="80" Padding="5" IsDefault="True"/>
            </StackPanel><!--/StackPanel-->

        </StackPanel><!--/StackPanel-->
    </Border><!--/Border-->
</Window>

